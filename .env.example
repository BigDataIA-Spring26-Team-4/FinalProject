# ═══════════════════════════════════════════════
# Maritime AI Sentinel — Environment Variables
# ═══════════════════════════════════════════════
# Copy to .env and fill in values: cp .env.example .env

# ── Snowflake ──
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=MARITIME_XS
SNOWFLAKE_DATABASE=MARITIME_SENTINEL
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN

# ── LLM Providers ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Model Selection (controls cost — change per task) ──
SUPERVISOR_MODEL=claude-sonnet-4-20250514
NEWS_ANALYST_MODEL=claude-sonnet-4-20250514
VESSEL_TRACKER_MODEL=gpt-4o-mini
CONFLICT_MONITOR_MODEL=gpt-4o-mini
SANCTIONS_CHECKER_MODEL=gpt-4o-mini
WEATHER_ANALYST_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── AIS Streaming ──
AISSTREAM_API_KEY=

# ── ACLED ──
ACLED_API_KEY=
ACLED_EMAIL=

# ── Weather ──
WEATHER_API_KEY=

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_GOLD_CACHE_TTL=300
REDIS_MCP_TOOL_CACHE_TTL=120
REDIS_AIS_POSITION_TTL=120
REDIS_EMBEDDING_CACHE_TTL=600

# ── ChromaDB ──
CHROMA_HOST=chromadb
CHROMA_PORT=8200

# ── FastAPI ──
API_HOST=0.0.0.0
API_PORT=8000

# ── LangSmith (optional — set to false if no API key) ──
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=maritime-sentinel
