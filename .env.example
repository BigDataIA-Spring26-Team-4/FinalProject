# ═══════════════════════════════════════════════
# Maritime AI Sentinel — Environment Variables
# ═══════════════════════════════════════════════
# Copy to .env and fill in values: cp .env.example .env

# ── Snowflake ──
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=MARITIME_XS
SNOWFLAKE_DATABASE=MARITIME_SENTINEL
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN

# ── LLM Providers ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── AIS Streaming ──
AISSTREAM_API_KEY=

# ── GDELT ──
# BigQuery access uses default application credentials or service account
GOOGLE_APPLICATION_CREDENTIALS=

# ── ACLED ──
ACLED_API_KEY=
ACLED_EMAIL=

# ── Weather ──
WEATHER_API_KEY=

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── ChromaDB ──
CHROMA_HOST=chromadb
CHROMA_PORT=8200

# ── FastAPI ──
API_HOST=0.0.0.0
API_PORT=8000

# ── LangSmith (optional) ──
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=maritime-sentinel
