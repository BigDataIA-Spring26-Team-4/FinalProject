# Airflow — runs inside its own Python 3.11 image, NOT in local Poetry venv
# Airflow has strict Python version requirements (no 3.13 support)
FROM apache/airflow:2.8.1-python3.11

USER root
RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*

USER airflow

# Install only the dependencies Airflow DAGs need (Snowflake connector, httpx, etc.)
# NOT the full Poetry project — Airflow manages its own deps
RUN pip install --no-cache-dir \
    snowflake-connector-python[pandas]==3.10.* \
    apache-airflow-providers-snowflake==5.* \
    httpx==0.27.* \
    structlog==24.* \
    gdeltdoc==1.* \
    python-dotenv==1.*
